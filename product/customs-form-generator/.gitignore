# --- Operational data (NEVER commit) ---
# Uploaded invoices contain real vendor/pricing data.
data/uploads/

# NOTE: data/*_rules.json (SKU -> HTSUS classification rules) is
# intentionally NOT ignored -- it's committed so it travels with the repo
# between computers, and index.html embeds its contents directly.
# See scripts/embed_rules.py and README.md.

# --- Python (used by scripts/, not by index.html itself) ---
__pycache__/
*.py[cod]
*$py.class
.Python
build/
dist/
*.egg-info/
.venv/
venv/
env/
ENV/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Node (only used transiently for local testing, never shipped) ---
.nodejs/
node_modules/

# --- Editor & OS ---
.vscode/
.idea/
*.swp
*.swo
.DS_Store
Thumbs.db
